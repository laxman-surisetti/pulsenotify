  "item": [
    {
      "name": "01 Register - success (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('username', 'alice_' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Returns username, access and role=user', () => {",
              "  pm.expect(j.username).to.eql(pm.collectionVariables.get('username'));",
              "  pm.expect(j.access).to.be.a('string');",
              "  pm.expect(j.role).to.eql('user');",
              "});",
              "pm.collectionVariables.set('user_token', j.access);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"alice@example.com\"\n}"
        }
      }
    },
