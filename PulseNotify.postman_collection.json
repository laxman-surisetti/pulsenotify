    {
      "name": "05 Create alert (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Alert is active with given route and threshold', () => {",
              "  pm.expect(j.origin).to.eql('DEL');",
              "  pm.expect(j.destination).to.eql('BOM');",
              "  pm.expect(parseFloat(j.threshold_price)).to.eql(4500);",
              "  pm.expect(j.status).to.eql('active');",
              "});",
              "pm.collectionVariables.set('alert_id', j.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/alerts/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": \"4500\"\n}"
        }
      }
    },
